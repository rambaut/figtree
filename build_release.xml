<!--
  build_release.xml

  ANT build file used by GitHub Actions to package FigTree releases for
  all platforms. It is intentionally separate from build.xml so that CI
  packaging concerns (pre-built JARs, hardened-runtime signing, notarisation)
  do not pollute the local development build.

  Usage (run on a macOS runner or locally after `ant -f build.xml dist`):

    ant -f build_release.xml package-mac \
        -Dversion=1.5.0

    ant -f build_release.xml package-linux \
        -Dversion=1.5.0

  Required property (must be supplied via -D or rely on default):
    version              e.g. 1.5.0

  Optional properties (all have sensible defaults):
    extra_release_tag    e.g. -beta1   (default: empty)
    dist.dir             directory containing pre-built figtree.jar
                         (default: dist)

  package-mac uses jpackage to produce a self-contained FigTree.app with
  the JDK used to run jpackage bundled as the runtime. Requires JDK 14+
  on PATH (JDK 21 recommended). No separate JVM install is needed.

  Signing, DMG creation, notarisation and stapling are all handled by the
  GitHub Actions workflow (.github/workflows/release.yml) so that this
  target can be run locally without any Apple certificates.
-->
<project basedir="." default="package-all" name="FigTree-Release">

    <!-- ============================================================
         Version / release properties  (override with -D on CLI)
         ============================================================ -->
    <property name="version"           value="1.5.0"/>
    <property name="version_number"    value="${version}"/>
    <property name="extra_release_tag" value=""/>
    <property name="copyright"         value="Copyright 2006-2026"/>

    <!-- Pre-built JAR location -->
    <property name="dist.dir"          value="dist"/>

    <!-- ============================================================
         Directory layout
         ============================================================ -->
    <property name="release_dir"     value="release"/>
    <property name="common_dir"      value="${release_dir}/common"/>
    <property name="Mac_dir"         value="${release_dir}/Mac"/>
    <property name="packaging_tools" value="packaging_tools"/>

    <!-- Package / app name -->
    <property name="FigTree_name"         value="FigTree"/>
    <property name="FigTree_package_name" value="FigTree"/>

    <!-- Platform package staging directories -->
    <property name="Mac_package_dir"
              value="${Mac_dir}/${FigTree_package_name} v${version}"/>
    <property name="Windows_dir"          value="${release_dir}/Windows"/>
    <property name="Linux_dir"            value="${release_dir}/Linux"/>
    <property name="Windows_package_dir"
              value="${Windows_dir}/${FigTree_package_name} v${version}"/>
    <property name="Linux_package_dir"
              value="${Linux_dir}/${FigTree_name}_v${version}"/>


    <!-- ==============================================================
         package-mac
         Produces:  release/Mac/FigTree v<version>/FigTree.app
                    alongside README.txt and examples/ — ready to DMG.

         Runs on:   macOS runner only (jpackage cannot cross-compile).
                    Requires JDK 14+ on PATH; JDK 21 recommended.

         The JDK used to run jpackage is also bundled as the app runtime,
         so the resulting app is self-contained — no system Java needed.

         Signing, DMG creation, notarisation and stapling are all handled
         by the GitHub Actions workflow so that this target can be run
         locally without any Apple certificates.
         ============================================================== -->
    <target name="package-mac" description="Create Mac .app bundle using jpackage (unsigned, with bundled JRE)">
        <delete dir="${Mac_package_dir}"/>
        <mkdir  dir="${Mac_package_dir}"/>

        <!-- jpackage writes FigTree.app into ${Mac_package_dir} -->
        <exec executable="jpackage" failonerror="true">
            <arg value="--type"/>
            <arg value="app-image"/>
            <arg value="--input"/>
            <arg value="${dist.dir}"/>
            <arg value="--main-jar"/>
            <arg value="figtree.jar"/>
            <arg value="--main-class"/>
            <arg value="figtree.application.FigTreeApplication"/>
            <arg value="--name"/>
            <arg value="${FigTree_name}"/>
            <arg value="--app-version"/>
            <arg value="${version_number}"/>
            <arg value="--icon"/>
            <arg value="${Mac_dir}/icons/FigTree.icns"/>
            <arg value="--dest"/>
            <arg value="${Mac_package_dir}"/>
            <arg value="--java-options"/>
            <arg value="-Xmx4096m"/>
            <arg value="--vendor"/>
            <arg value="Andrew Rambaut"/>
            <arg value="--copyright"/>
            <arg value="${copyright} Andrew Rambaut"/>
            <arg value="--mac-package-identifier"/>
            <arg value="uk.ac.ed.bio.figtree"/>
        </exec>

        <!-- README and examples sit alongside FigTree.app in the DMG window -->
        <copy file="${common_dir}/README.txt" todir="${Mac_package_dir}"/>
        <copy todir="${Mac_package_dir}/examples">
            <fileset dir="examples"/>
        </copy>

        <echo message="Mac .app created in: ${Mac_package_dir}/FigTree.app"/>
        <echo message="Next (CI): codesign .app, hdiutil create DMG, notarytool, stapler."/>
    </target>


    <!-- ==============================================================
         package-windows
         Produces:  release/FigTree v<version><tag>.zip
         Runs on:   Windows runner only — jpackage cannot cross-compile.
                    Uses the JDK's jpackage tool to produce a self-contained
                    app-image with a bundled JRE, then ZIPs it.
         ============================================================== -->
    <target name="package-windows" description="Package Windows release using jpackage (requires Windows runner)">
        <!-- jpackage writes the app-image to ${Windows_dir}/${FigTree_name}/ -->
        <delete dir="${Windows_dir}/${FigTree_name}"/>
        <mkdir  dir="${Windows_dir}"/>

        <exec executable="jpackage" failonerror="true">
            <arg value="--type"/>
            <arg value="app-image"/>
            <arg value="--input"/>
            <arg value="${dist.dir}"/>
            <arg value="--main-jar"/>
            <arg value="figtree.jar"/>
            <arg value="--main-class"/>
            <arg value="figtree.application.FigTreeApplication"/>
            <arg value="--name"/>
            <arg value="${FigTree_name}"/>
            <arg value="--app-version"/>
            <arg value="${version}"/>
            <arg value="--icon"/>
            <arg value="${Windows_dir}/icons/FigTree.ico"/>
            <arg value="--dest"/>
            <arg value="${Windows_dir}"/>
            <arg value="--java-options"/>
            <arg value="-Xmx4096m"/>
            <arg value="--vendor"/>
            <arg value="Andrew Rambaut"/>
            <arg value="--description"/>
            <arg value="FigTree - Tree Figure Drawing Tool"/>
            <arg value="--copyright"/>
            <arg value="${copyright} Andrew Rambaut"/>
        </exec>

        <zip destfile="${release_dir}/${FigTree_name} v${version}${extra_release_tag}.zip">
            <zipfileset dir="${Windows_dir}/${FigTree_name}"
                        prefix="${FigTree_name} v${version}"/>
        </zip>

        <echo message="Windows package: ${release_dir}/${FigTree_name} v${version}${extra_release_tag}.zip"/>
    </target>


    <!-- ==============================================================
         package-linux
         Produces:  release/FigTree_v<version><tag>.tgz
         Runs on:   macOS or Linux runner
         Uses GNU tar format (via ANT tar task) for Linux compatibility.
         ============================================================== -->
    <target name="package-linux" description="Package Linux/Unix release">
        <delete dir="${Linux_package_dir}"/>
        <mkdir  dir="${Linux_package_dir}"/>

        <copy todir="${Linux_package_dir}/bin">
            <fileset dir="${Linux_dir}/scripts"/>
        </copy>
        <!-- Preserve executable bits on the shell scripts -->
        <chmod dir="${Linux_package_dir}/bin" perm="755" includes="**/**"/>

        <copy file="${Linux_dir}/icons/figtree.png" todir="${Linux_package_dir}/images"/>

        <copy file="${dist.dir}/figtree.jar" todir="${Linux_package_dir}/lib"/>

        <copy file="${common_dir}/README.txt" todir="${Linux_package_dir}"/>
        <copy todir="${Linux_package_dir}/examples">
            <fileset dir="examples"/>
        </copy>

        <!--
            ANT's built-in tar task is Java-based and writes a POSIX-compatible
            archive that GNU tar (Linux) reads correctly. The filemode attribute
            on the bin tarfileset preserves executable permissions for scripts.
        -->
        <tar destfile="${release_dir}/${FigTree_name}_v${version}${extra_release_tag}.tgz"
             compression="gzip"
             longfile="gnu">
            <tarfileset dir="${Linux_package_dir}"
                        prefix="${FigTree_name}_v${version}"
                        filemode="755">
                <include name="bin/**"/>
            </tarfileset>
            <tarfileset dir="${Linux_package_dir}"
                        prefix="${FigTree_name}_v${version}">
                <exclude name="bin/**"/>
                <include name="**/**"/>
            </tarfileset>
        </tar>

        <echo message="Linux/Unix package: ${release_dir}/${FigTree_name}_v${version}${extra_release_tag}.tgz"/>
    </target>


    <!-- ── Convenience target: build Mac + Linux packages ─────── -->
    <!--     Windows packaging requires a Windows runner; run           -->
    <!--     package-windows separately on windows-latest in CI.        -->
    <target name="package-all"
            depends="package-linux, package-mac"
            description="Build Mac and Linux packages (macOS runner). Windows uses package-windows on a Windows runner."/>

</project>
