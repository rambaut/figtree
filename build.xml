<?xml version="1.0" ?>

<project name="FigTree" default="dist" basedir=".">
    <description>
        Build file for FigTree
        $Id:$
    </description>

    <!-- set global properties for this build -->
    <property name="src" location="src"/>
    <property name="build" location="build"/>

    <property name="lib" location="lib"/>
    <property name="dist" location="dist"/>
    <property name="packaging_tools" value="packaging_tools" />

    <property environment="env"/>

    <target name="clean">
        <mkdir dir="${build}"/>
        <delete includeEmptyDirs="true">
            <fileset dir="${build}" includes="**/*"/>
        </delete>

    </target>

    <target name="init">
        <!-- Create the time stamp -->
        <tstamp/>
        <!-- Create the build directory structure used by compile -->
        <mkdir dir="${build}"/>
        <mkdir dir="${dist}"/>
        <mkdir dir="${lib}"/>
    </target>

    <target name="compile" depends="init">
        <!-- Compile the java code from ${src} into ${build} -->
        <javac release="11" srcdir="${src}" destdir="${build}"
            classpath="${lib}/jebl.jar:${lib}/jam.jar:${lib}/batik-awt-util.jar:${lib}/batik-dom.jar:${lib}/batik-ext.jar:${lib}/batik-svggen.jar:${lib}/batik-util.jar:${lib}/batik-xml.jar:${lib}/xml-apis.jar:${lib}/iText.jar:${lib}/VAqua12.jar:${lib}/flatlaf-3.2.5.jar:${lib}/jwt/servlet-api-2.5-6.0.2.jar:${lib}/jwt/jwt-3.1.7pre1.jar">
            <include name="figtree/**"/>
        </javac>
        <copy todir="${build}" verbose="true">
            <fileset dir="${src}" includes="figtree/**/*.png,figtree/**/*.gif"/>
        </copy>
    </target>

    <target name="dist" depends="compile" description="generate the distribution">
        <!-- Create the distribution directory -->
        <mkdir dir="${dist}"/>

        <jar jarfile="${dist}/figtree.jar">
            <zipgroupfileset dir="${lib}" includes="jebl.jar"/>
            <zipgroupfileset dir="${lib}" includes="jam.jar"/>
            <zipgroupfileset dir="${lib}" includes="batik*.jar"/>
            <zipgroupfileset dir="${lib}" includes="xml-apis.jar"/>
            <zipgroupfileset dir="${lib}" includes="iText.jar"/>
            <zipgroupfileset dir="${lib}" includes="flatlaf-3.2.5.jar"/>
            <fileset dir="${build}" includes="**/*.class,**/*.properties,**/*.png,**/*.gif"/>
            <manifest>
                <attribute name="Built-By" value="${user.name}"/>
                <attribute name="Main-Class" value="figtree.application.FigTreeApplication"/>
            </manifest>
        </jar>

        <jar jarfile="${dist}/figtreepanel.jar">
            <fileset dir="${build}"
                     includes="figtree/panel/**/*.class,figtree/treeviewer/**/*.class,**/*.properties,**/*.png,**/*.gif"
                    />

            <manifest>
                <attribute name="Built-By" value="${user.name}"/>
            </manifest>
        </jar>

        <jar jarfile="${dist}/figtree-pdf.jar">
            <fileset dir="${build}"
                     includes="figtree/panel/**/*.class,figtree/treeviewer/**/*.class,**/*.properties,**/*.png,**/*.gif"
                    />

            <manifest>
                <attribute name="Built-By" value="${user.name}"/>
            </manifest>
        </jar>

    </target>

    <property name="version" value="1.5.0_pre" />
    <property name="version_number" value="1.5.0" />
    <property name="release_dir" value="release" />
    <property name="name" value="FigTree" />

    <property name="common_dir" value="${release_dir}/common" />

    <property name="Mac_dir" value="${release_dir}/Mac" />
    <property name="Linux_dir" value="${release_dir}/Linux" />
    <property name="Windows_dir" value="${release_dir}/Windows" />

    <property name="Mac_package_dir" value="${Mac_dir}/${name} v${version}" />
    <property name="Linux_package_dir" value="${Linux_dir}/${name}_v${version}" />
    <property name="Windows_package_dir" value="${Windows_dir}/${name} v${version}" />

    <!-- Need to either install Launch4j under {BEAST workspace}/${release}
                 or install it in the default directory and change the location of launch4j.dir -->
    <target name="windows_Release" depends="dist"
            description="release Windows version of FigTree">

        <delete dir="${Windows_package_dir}" />
        <!-- Create the release directory -->
        <mkdir dir="${Windows_package_dir}" />

        <property name="launch4j.dir" location="${packaging_tools}/windows/launch4j" />
        <taskdef name="launch4j" classname="net.sf.launch4j.ant.Launch4jTask"
                 classpath="${launch4j.dir}/launch4j.jar :${launch4j.dir}/lib/xstream.jar"/>

        <copy file="${dist}/figtree.jar" todir="${Windows_package_dir}/lib"/>
        <copy todir="${Windows_package_dir}/lib">
            <fileset dir="${Windows_dir}/lib"/>
        </copy>

        <copy todir="${Windows_package_dir}">
            <fileset dir="${common_dir}/"/>
        </copy>

        <launch4j configFile="${Windows_dir}/FigTree_launch4j.xml"
                  outfile="${Windows_package_dir}/${name} v${version}.exe"
                  fileVersion="${version_number}.0"
                  txtFileVersion="${version}"
                  productVersion="${version_number}.0"
                  txtProductVersion="${version}"/>

        <zip destfile="${release_dir}/${name} v${version}.zip">
            <zipfileset dir="${Windows_package_dir}" prefix="${name} v${version}"/>
        </zip>

        <echo message="Windows version release is finished." />
    </target>

    <target name="linux_unix_Release" depends="dist"
            description="release Linux/Unix version of FigTree">
        <delete dir="${Linux_package_dir}" />
        <!-- Create the release directory -->
        <mkdir dir="${Linux_package_dir}" />

        <copy todir="${Linux_package_dir}/bin">
            <fileset dir="${Linux_dir}/scripts"/>
        </copy>

        <copy file="${Linux_dir}/icons/figtree.png" todir="${Linux_package_dir}/images"/>
        <copy file="${dist}/figtree.jar" todir="${Linux_package_dir}/lib"/>
        <!--
        <copy todir="${Linux_package_dir}/lib">
            <fileset dir="${Linux_dir}/lib"/>
        </copy>
        -->
        <copy todir="${Linux_package_dir}">
            <fileset dir="${common_dir}/"/>
        </copy>

        <tar destfile="${release_dir}/${name}_v${version}.tgz" compression="gzip">
            <tarfileset dir="${Linux_package_dir}" prefix="${name}_v${version}"/>
        </tar>

        <echo message="Linux/Unix version release is finished." />
    </target>

    <property name="AppleSigner" value="Developer ID Application: Andrew Rambaut (9E4WXAQ6SE)" />
    <!-- SHA-1 of the valid Developer ID cert: avoids ambiguity when two certs share the same name -->
    <property name="AppleSignerHash" value="979926FBDE08C6F16DEA9E11A321E16F01502951" />
    <!-- Use the bundled JDK's own jpackage -->
    <property name="jpackage.exec"
              value="/Users/rambaut/Library/Java/JavaVirtualMachines/azul-21.0.1/Contents/Home/bin/jpackage"/>

    <target name="mac_release" depends="dist"
            description="release Mac version of FigTree using jpackage (JDK 14+ required)">

        <!-- Step 1: build unsigned .app image -->
        <delete dir="${dist}/app-input"/>
        <mkdir dir="${dist}/app-input"/>
        <copy file="${dist}/figtree.jar" todir="${dist}/app-input"/>
        <delete dir="${dist}/${name}.app"/>

        <exec executable="${jpackage.exec}" failonerror="true">
            <arg value="--type"/><arg value="app-image"/>
            <arg value="--name"/><arg value="${name}"/>
            <arg value="--app-version"/><arg value="${version_number}"/>
            <arg value="--input"/><arg value="${dist}/app-input"/>
            <arg value="--main-jar"/><arg value="figtree.jar"/>
            <arg value="--main-class"/><arg value="figtree.application.FigTreeApplication"/>
            <arg value="--icon"/><arg value="JPackage/figtree/FigTree.icns"/>
            <arg value="--dest"/><arg value="${dist}"/>
            <arg value="--java-options"/><arg value="-Xmx4096M"/>
            <arg value="--java-options"/><arg value="-Dapple.laf.useScreenMenuBar=true"/>
            <arg value="--java-options"/><arg value="-Dapple.awt.application.name=${name}"/>
            <arg value="--mac-package-identifier"/><arg value="uk.ac.ed.bio.figtree"/>
            <arg value="--mac-package-name"/><arg value="${name}"/>
            <arg value="--file-associations"/><arg value="JPackage/figtree/tree-file-associations.properties"/>
            <arg value="--file-associations"/><arg value="JPackage/figtree/tre-file-associations.properties"/>
        </exec>

        <!-- Step 2: re-sign all bundled dylibs with -force flag to replace pre-existing JDK vendor signatures -->
        <exec executable="bash" failonerror="true">
            <arg value="-c"/>
            <arg value="find '${dist}/${name}.app' \( -name '*.dylib' -o -name '*.jnilib' \) | while read f; do codesign --force -s '${AppleSignerHash}' --timestamp --options runtime --entitlements '${basedir}/JPackage/figtree/FigTree.entitlements' &quot;$f&quot; || exit 1; done"/>
        </exec>

        <!-- Step 3: sign the full .app bundle (deep, replacing any prior signature) -->
        <exec executable="codesign" failonerror="true">
            <arg value="--force"/>
            <arg value="--deep"/>
            <arg value="-s"/><arg value="${AppleSignerHash}"/>
            <arg value="--timestamp"/>
            <arg value="--options"/><arg value="runtime"/>
            <arg value="--entitlements"/><arg value="JPackage/figtree/FigTree.entitlements"/>
            <arg value="${dist}/${name}.app"/>
        </exec>

        <!-- Step 4: package the signed .app into a DMG -->
        <exec executable="${jpackage.exec}" failonerror="true">
            <arg value="--type"/><arg value="dmg"/>
            <arg value="--name"/><arg value="${name}"/>
            <arg value="--app-version"/><arg value="${version_number}"/>
            <arg value="--app-image"/><arg value="${dist}/${name}.app"/>
            <arg value="--dest"/><arg value="${release_dir}"/>
            <arg value="--mac-package-identifier"/><arg value="uk.ac.ed.bio.figtree"/>
            <arg value="--mac-package-name"/><arg value="${name}"/>
        </exec>

        <!--
        Notarize the DMG for distribution outside the App Store (required on macOS 10.15+).
        First store credentials once with:
          xcrun notarytool store-credentials "figtree-notarize" -apple-id YOUR_APPLE_ID -team-id 9E4WXAQ6SE -password APP_SPECIFIC_PASSWORD

        <exec executable="xcrun" failonerror="true">
            <arg value="notarytool"/><arg value="submit"/>
            <arg value="${release_dir}/${name}-${version_number}.dmg"/>
            <arg value="-keychain-profile"/><arg value="figtree-notarize"/>
            <arg value="-wait"/>
        </exec>
        <exec executable="xcrun" failonerror="true">
            <arg value="stapler"/><arg value="staple"/>
            <arg value="${release_dir}/${name}-${version_number}.dmg"/>
        </exec>
        -->

        <echo message="Mac version release is finished." />
    </target>

    <target name="windows_jpackage" depends="dist"
            description="release Windows version of FigTree using jpackage with bundled JRE">

        <delete dir="${dist}/app-input"/>
        <mkdir dir="${dist}/app-input"/>
        <copy file="${dist}/figtree.jar" todir="${dist}/app-input"/>

        <exec executable="jpackage" failonerror="true">
            <arg value="--type"/><arg value="exe"/>
            <arg value="--name"/><arg value="${name}"/>
            <arg value="--app-version"/><arg value="${version_number}"/>
            <arg value="--input"/><arg value="${dist}/app-input"/>
            <arg value="--main-jar"/><arg value="figtree.jar"/>
            <arg value="--main-class"/><arg value="figtree.application.FigTreeApplication"/>
            <arg value="--icon"/><arg value="${Windows_dir}/icons/FigTree.ico"/>
            <arg value="--dest"/><arg value="${release_dir}"/>
            <arg value="--java-options"/><arg value="-Xmx4096M"/>
            <arg value="--win-menu"/>
            <arg value="--win-shortcut"/>
            <arg value="--win-dir-chooser"/>
            <arg value="--file-associations"/><arg value="JPackage/figtree/tree-file-associations.properties"/>
            <arg value="--file-associations"/><arg value="JPackage/figtree/tre-file-associations.properties"/>
        </exec>

        <echo message="Windows version release is finished (jpackage)." />
    </target>

    <target name="linux_jpackage" depends="dist"
            description="release Linux version of FigTree using jpackage with bundled JRE">

        <delete dir="${dist}/app-input"/>
        <mkdir dir="${dist}/app-input"/>
        <copy file="${dist}/figtree.jar" todir="${dist}/app-input"/>

        <exec executable="jpackage" failonerror="true">
            <arg value="--type"/><arg value="deb"/>
            <arg value="--name"/><arg value="figtree"/>
            <arg value="--app-version"/><arg value="${version_number}"/>
            <arg value="--input"/><arg value="${dist}/app-input"/>
            <arg value="--main-jar"/><arg value="figtree.jar"/>
            <arg value="--main-class"/><arg value="figtree.application.FigTreeApplication"/>
            <arg value="--icon"/><arg value="${Linux_dir}/icons/figtree.png"/>
            <arg value="--dest"/><arg value="${release_dir}"/>
            <arg value="--java-options"/><arg value="-Xmx4096M"/>
            <arg value="--linux-shortcut"/>
            <arg value="--file-associations"/><arg value="JPackage/figtree/tree-file-associations.properties"/>
            <arg value="--file-associations"/><arg value="JPackage/figtree/tre-file-associations.properties"/>
        </exec>

        <echo message="Linux version release is finished (jpackage)." />
    </target>

