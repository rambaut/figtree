<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for JIT compilation (JVM) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Required for JVM interpreted mode and some JVM internals -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Required for the JVM to function with hardened runtime -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- Required to load Java agent libraries and JVM dylibs from the bundled JRE -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
